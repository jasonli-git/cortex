# Cortex backend configuration (all optional — defaults work out of the box).
# Copy to .env and adjust as needed.

# Where the database and resource store live (relative to backend/).
#PKS_DATA_DIR=data

#PKS_HOST=127.0.0.1
#PKS_PORT=8000

# AI provider (required from Milestone 3 onward).
#ANTHROPIC_API_KEY=sk-ant-...
#PKS_HEAVY_MODEL=claude-opus-4-8
#PKS_FAST_MODEL=claude-haiku-4-5
